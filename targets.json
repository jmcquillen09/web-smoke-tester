{
  "defaultTarget": "demo-site",
  "targets": {
    "demo-site": {
      "baseUrl": "http://localhost:4020",
      "servesDemoSite": true,
      "expectedApiFailures": [
        { "path": "/books/search", "check": "body" },
        { "path": "/authors", "check": "contentType" },
        { "path": "/authors/{authorId}", "check": "status" },
        { "path": "/stats", "check": "status" },
        { "path": "/account/orders", "check": "auth" }
      ]
    },
    "local": {
      "baseUrl": "http://localhost:3000",
      "paths": ["/"],
      "crawlLimit": 10,
      "ignoreHttpsErrors": true
    },
    "demo-api": {
      "baseUrl": "http://localhost:4010",
      "servesDemoApi": true,
      "expectedApiFailures": [
        { "path": "/books/search", "check": "body" },
        { "path": "/authors", "check": "contentType" },
        { "path": "/authors/{authorId}", "check": "status" },
        { "path": "/stats", "check": "status" },
        { "path": "/account/orders", "check": "auth" }
      ],
      "crawlLimit": 0
    },
    "google": {
      "baseUrl": "https://www.google.com",
      "crawlLimit": 3
    },
    "jj-keller": {
      "baseUrl": "https://www.jjkeller.com",
      "crawlLimit": 3
    }
  }
}
